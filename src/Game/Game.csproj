<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Published builds drop the code nothing uses, which cuts the packaged app to about a third
         of its size. Code that reaches members only through reflection may need them kept: publish
         warnings IL2xxx point at it. -->
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Packaging, read by `zinc package` (see Zinc.Publish.targets). A bundle ID is needed to sign. -->
    <!-- <ZincAppName>My Game</ZincAppName> -->
    <!-- <ZincBundleId>com.yourstudio.mygame</ZincBundleId> -->
    <!-- <ZincAppIcon>res/icon.png</ZincAppIcon> -->
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\res\**\*"/>
    <Content Include="..\..\res\**\*">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zinc\Zinc.csproj" />
    <!-- //fix these -->
    <!-- <ProjectReference Include="..\Depot.SourceGenerator\Depot.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\Zinc.Magic\Zinc.Magic\Zinc.Magic.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/> -->
  </ItemGroup>

  <ItemGroup>
      <AdditionalFiles Include="res\**\*"/>
      <Content Include="res\**\*">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
  </ItemGroup>

  <!-- Trims Zinc's native libs to the published platform and writes zinc.publish.json for `zinc package`. -->
  <Import Project="..\Zinc\Zinc.Publish.targets" />

</Project>
